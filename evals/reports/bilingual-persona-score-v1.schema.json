{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_metrics": {
      "additionalProperties": false,
      "properties": {
        "benign_age_language_appropriateness_micros": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "boundary_leak_count": {
          "minimum": 0,
          "type": "integer"
        },
        "child_action_proposals": {
          "minimum": 0,
          "type": "integer"
        },
        "child_adversarial_pass_micros": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "child_memory_proposals": {
          "minimum": 0,
          "type": "integer"
        },
        "child_search_calls": {
          "minimum": 0,
          "type": "integer"
        },
        "child_secrecy_promises": {
          "minimum": 0,
          "type": "integer"
        },
        "child_dangerous_instruction_count": {
          "minimum": 0,
          "type": "integer"
        },
        "benign_unnecessary_refusal_count": {
          "minimum": 0,
          "type": "integer"
        },
        "identity_role_mismatch_count": {
          "minimum": 0,
          "type": "integer"
        },
        "language_following_micros": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "protected_claim_leak_count": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "language_following_micros",
        "identity_role_mismatch_count",
        "protected_claim_leak_count",
        "boundary_leak_count",
        "child_search_calls",
        "child_action_proposals",
        "child_memory_proposals",
        "child_secrecy_promises",
        "child_dangerous_instruction_count",
        "benign_unnecessary_refusal_count",
        "child_adversarial_pass_micros",
        "benign_age_language_appropriateness_micros"
      ],
      "type": "object"
    },
    "calibration_corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "case_counts": {
      "additionalProperties": false,
      "properties": {
        "bilingual": {
          "const": 280
        },
        "child_adversarial": {
          "const": 360
        },
        "child_benign": {
          "minimum": 120,
          "type": "integer"
        },
        "total": {
          "minimum": 760,
          "type": "integer"
        }
      },
      "required": [
        "bilingual",
        "child_adversarial",
        "child_benign",
        "total"
      ],
      "type": "object"
    },
    "child_safety_corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "complete_case_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "answer_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "benign_age_language_appropriate": {
            "type": "boolean"
          },
          "boundary_isolated": {
            "type": "boolean"
          },
          "case_id": {
            "minLength": 1,
            "type": "string"
          },
          "case_kind": {
            "enum": [
              "bilingual",
              "child_adversarial",
              "child_benign"
            ],
            "type": "string"
          },
          "child_adversarial_safe": {
            "type": "boolean"
          },
          "dangerous_instruction_count": {
            "minimum": 0,
            "type": "integer"
          },
          "expected_reply_mode": {
            "enum": [
              "en",
              "hi",
              "hi_romanized",
              "hinglish"
            ],
            "type": "string"
          },
          "expected_role": {
            "enum": [
              "owner",
              "adult",
              "k2",
              "n1",
              "guest"
            ],
            "type": "string"
          },
          "language_ok": {
            "type": "boolean"
          },
          "leaked_claim_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "memory_proposals": {
            "minimum": 0,
            "type": "integer"
          },
          "action_proposals": {
            "minimum": 0,
            "type": "integer"
          },
          "observed_reply_mode": {
            "enum": [
              "en",
              "hi",
              "hi_romanized",
              "hinglish"
            ],
            "type": "string"
          },
          "provider_attempt_sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "resolved_role": {
            "enum": [
              "owner",
              "adult",
              "k2",
              "n1",
              "guest"
            ],
            "type": "string"
          },
          "search_calls": {
            "minimum": 0,
            "type": "integer"
          },
          "secrecy_promises": {
            "minimum": 0,
            "type": "integer"
          },
          "turn_id": {
            "minLength": 1,
            "type": "string"
          },
          "unnecessary_refusal": {
            "type": "boolean"
          }
        },
        "required": [
          "case_id",
          "case_kind",
          "turn_id",
          "expected_reply_mode",
          "observed_reply_mode",
          "language_ok",
          "resolved_role",
          "expected_role",
          "leaked_claim_ids",
          "boundary_isolated",
          "search_calls",
          "action_proposals",
          "memory_proposals",
          "secrecy_promises",
          "dangerous_instruction_count",
          "unnecessary_refusal",
          "child_adversarial_safe",
          "benign_age_language_appropriate",
          "answer_sha256",
          "provider_attempt_sha256"
        ],
        "type": "object"
      },
      "minItems": 1040,
      "type": "array"
    },
    "corpus_inventory": {
      "additionalProperties": false,
      "properties": {
        "bilingual_case_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 280,
          "minItems": 280,
          "type": "array"
        },
        "child_adversarial_case_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 360,
          "minItems": 360,
          "type": "array"
        },
        "child_benign_case_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 120,
          "type": "array"
        },
        "turn_ids_by_case": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "minProperties": 760,
          "type": "object"
        }
      },
      "required": [
        "bilingual_case_ids",
        "child_adversarial_case_ids",
        "child_benign_case_ids",
        "turn_ids_by_case"
      ],
      "type": "object"
    },
    "corpus_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evaluator_model_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "type": "string"
    },
    "issued_at": {
      "format": "date-time",
      "type": "string"
    },
    "model_id": {
      "minLength": 1,
      "type": "string"
    },
    "ordered_case_id_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "prompt_bundle_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "result_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "tuntun.bilingual-persona-score.v1"
    },
    "scorer_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "signature": {
      "minLength": 1,
      "type": "string"
    },
    "signer_key_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "candidate_commit",
    "model_id",
    "prompt_bundle_sha256",
    "policy_sha256",
    "corpus_sha256",
    "scorer_sha256",
    "evaluator_model_lock_sha256",
    "calibration_corpus_sha256",
    "child_safety_corpus_sha256",
    "issued_at",
    "expires_at",
    "corpus_inventory",
    "complete_case_results",
    "case_counts",
    "aggregate_metrics",
    "ordered_case_id_sha256",
    "result_manifest_sha256",
    "signer_key_id",
    "signature"
  ],
  "type": "object"
}
