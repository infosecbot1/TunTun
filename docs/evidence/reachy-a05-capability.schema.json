    "RuntimeDependency": {
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "distribution": {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^(?:[0-9]{1,3}[.]){3}[0-9]{1,3}$"
              },
              {
                "pattern": "[.][Ll][Oo][Cc][Aa][Ll]$"
              },
              {
                "pattern": "(?:^|[-_.+!])[Hh][Oo][Ss][Tt][Nn][Aa][Mm][Ee](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Pp][Rr][Ii][Nn][Cc][Ii][Pp][Aa][Ll](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Ss][Ee][Rr][Ii][Aa][Ll](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Ss][Ss][Ii][Dd](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Uu][Ss][Ee][Rr][Nn][Aa][Mm][Ee](?:$|[-_.+!])"
              },
              {
                "pattern": "[Xx][Nn]--"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Distribution",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "^(?:[0-9]{1,3}[.]){3}[0-9]{1,3}$"
              },
              {
                "pattern": "[.][Ll][Oo][Cc][Aa][Ll]$"
              },
              {
                "pattern": "(?:^|[-_.+!])[Hh][Oo][Ss][Tt][Nn][Aa][Mm][Ee](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Pp][Rr][Ii][Nn][Cc][Ii][Pp][Aa][Ll](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Ss][Ee][Rr][Ii][Aa][Ll](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Ss][Ss][Ii][Dd](?:$|[-_.+!])"
              },
              {
                "pattern": "(?:^|[-_.+!])[Uu][Ss][Ee][Rr][Nn][Aa][Mm][Ee](?:$|[-_.+!])"
              },
              {
                "pattern": "[Xx][Nn]--"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]{0,63}$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "distribution",
        "version",
        "artifact_sha256"
      ],
      "title": "RuntimeDependency",
      "type": "object"
    },
