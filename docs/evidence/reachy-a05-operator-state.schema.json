{
  "$defs": {
    "PttInputMode": {
      "enum": [
        "reachy_local",
        "core_terminal_toggle"
      ],
      "title": "PttInputMode",
      "type": "string"
    },
    "ReachyA05CommissioningStateV1": {
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "$ref": "#/$defs/ReachyA05DeploymentBinding"
        },
        "identity_file_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity File Sha256",
          "type": "string"
        },
        "identity_path": {
          "maxLength": 512,
          "minLength": 2,
          "not": {
            "anyOf": [
              {
                "pattern": "//"
              },
              {
                "pattern": "(?:^|/)[.]{1,2}(?:/|$)"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^/[^\\x00\\r\\n]*$",
          "title": "Identity Path",
          "type": "string"
        },
        "identity_public_key_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Identity Public Key Sha256",
          "type": "string"
        },
        "identity_public_key_type": {
          "const": "ssh-ed25519",
          "title": "Identity Public Key Type",
          "type": "string"
        },
        "known_hosts_file_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Known Hosts File Sha256",
          "type": "string"
        },
        "known_hosts_path": {
          "maxLength": 512,
          "minLength": 2,
          "not": {
            "anyOf": [
              {
                "pattern": "//"
              },
              {
                "pattern": "(?:^|/)[.]{1,2}(?:/|$)"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^/[^\\x00\\r\\n]*$",
          "title": "Known Hosts Path",
          "type": "string"
        },
        "pinned_host_key_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pinned Host Key Sha256",
          "type": "string"
        },
        "pinned_host_key_type": {
          "const": "ssh-ed25519",
          "title": "Pinned Host Key Type",
          "type": "string"
        },
        "reachy_ipv4": {
          "maxLength": 15,
          "minLength": 7,
          "not": {
            "pattern": "[\\r\\n]"
          },
          "pattern": "^(?:10(?:[.](?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|172[.](?:1[6-9]|2[0-9]|3[01])(?:[.](?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){2}|192[.]168(?:[.](?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){2})$",
          "title": "Reachy Ipv4",
          "type": "string"
        },
        "record_kind": {
          "const": "bound",
          "title": "Record Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "tuntun.reachy-a05-operator-state.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "ssh_port": {
          "const": 22,
          "title": "Ssh Port",
          "type": "integer"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "deployment",
        "reachy_ipv4",
        "ssh_port",
        "identity_path",
        "known_hosts_path",
        "identity_public_key_type",
        "pinned_host_key_type",
        "identity_public_key_sha256",
        "pinned_host_key_sha256",
        "identity_file_sha256",
        "known_hosts_file_sha256"
      ],
      "title": "ReachyA05CommissioningStateV1",
      "type": "object"
    },
    "ReachyA05DeploymentBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "staged"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "active_bundle_sha256": {
                "type": "null"
              },
              "staged_bundle_sha256": {
                "maxLength": 64,
                "minLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "active"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "active_bundle_sha256": {
                "maxLength": 64,
                "minLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "staged_bundle_sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "commissioned",
                  "removed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "active_bundle_sha256": {
                "type": "null"
              },
              "staged_bundle_sha256": {
                "type": "null"
              }
            }
          }
        }
      ],
      "properties": {
        "active_bundle_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Active Bundle Sha256"
        },
        "authorized_key_line_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Authorized Key Line Sha256",
          "type": "string"
        },
        "boot_identity_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Boot Identity Sha256",
          "type": "string"
        },
        "capability_report_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Capability Report Sha256",
          "type": "string"
        },
        "commissioning_id": {
          "format": "uuid",
          "title": "Commissioning Id",
          "type": "string"
        },
        "dispatcher_path": {
          "maxLength": 512,
          "minLength": 2,
          "not": {
            "anyOf": [
              {
                "pattern": "//"
              },
              {
                "pattern": "(?:^|/)[.]{1,2}(?:/|$)"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^/(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+$",
          "title": "Dispatcher Path",
          "type": "string"
        },
        "dispatcher_protocol_version": {
          "const": "tuntun.reachy-a05-dispatcher.v1",
          "title": "Dispatcher Protocol Version",
          "type": "string"
        },
        "dispatcher_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Dispatcher Sha256",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "ptt_input_mode": {
          "$ref": "#/$defs/PttInputMode"
        },
        "remote_home": {
          "maxLength": 512,
          "minLength": 2,
          "not": {
            "anyOf": [
              {
                "pattern": "//"
              },
              {
                "pattern": "(?:^|/)[.]{1,2}(?:/|$)"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^/(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+$",
          "title": "Remote Home",
          "type": "string"
        },
        "remote_root": {
          "maxLength": 512,
          "minLength": 2,
          "not": {
            "anyOf": [
              {
                "pattern": "//"
              },
              {
                "pattern": "(?:^|/)[.]{1,2}(?:/|$)"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^/(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+$",
          "title": "Remote Root",
          "type": "string"
        },
        "runtime": {
          "$ref": "#/$defs/ReachyA05RuntimeBinding"
        },
        "ssh_principal": {
          "maxLength": 32,
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "const": "root"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^[a-z_][a-z0-9_-]{0,31}$",
          "title": "Ssh Principal",
          "type": "string"
        },
        "staged_bundle_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Staged Bundle Sha256"
        },
        "state_generation": {
          "maximum": 9007199254740991,
          "minimum": 1,
          "title": "State Generation",
          "type": "integer"
        },
        "status": {
          "enum": [
            "commissioned",
            "staged",
            "active",
            "removed"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "commissioning_id",
        "state_generation",
        "status",
        "issued_at",
        "expires_at",
        "boot_identity_sha256",
        "capability_report_sha256",
        "ptt_input_mode",
        "runtime",
        "ssh_principal",
        "remote_home",
        "remote_root",
        "dispatcher_path",
        "dispatcher_protocol_version",
        "dispatcher_sha256",
        "authorized_key_line_sha256",
        "staged_bundle_sha256",
        "active_bundle_sha256"
      ],
      "title": "ReachyA05DeploymentBinding",
      "type": "object"
    },
    "ReachyA05RevokedTombstoneV1": {
      "additionalProperties": false,
      "description": "Content-minimized local record after remote and credential removal.",
      "properties": {
        "commissioning_id": {
          "format": "uuid",
          "title": "Commissioning Id",
          "type": "string"
        },
        "prior_deployment_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prior Deployment Sha256",
          "type": "string"
        },
        "record_kind": {
          "const": "revoked",
          "title": "Record Kind",
          "type": "string"
        },
        "revocation_proof_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Revocation Proof Sha256",
          "type": "string"
        },
        "revoked_at": {
          "format": "date-time",
          "title": "Revoked At",
          "type": "string"
        },
        "schema_version": {
          "const": "tuntun.reachy-a05-operator-state.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "state_generation": {
          "maximum": 9007199254740991,
          "minimum": 2,
          "title": "State Generation",
          "type": "integer"
        },
        "status": {
          "const": "revoked",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "record_kind",
        "commissioning_id",
        "state_generation",
        "status",
        "revoked_at",
        "prior_deployment_sha256",
        "revocation_proof_sha256"
      ],
      "title": "ReachyA05RevokedTombstoneV1",
      "type": "object"
    },
    "ReachyA05RuntimeBinding": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "python_abi": {
                "const": "cp311"
              }
            },
            "required": [
              "python_abi"
            ]
          },
          "then": {
            "properties": {
              "python_version": {
                "not": {
                  "pattern": "[\\r\\n]"
                },
                "pattern": "^3[.]11[.](?:0|[1-9][0-9]{0,2})$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "python_abi": {
                "const": "cp312"
              }
            },
            "required": [
              "python_abi"
            ]
          },
          "then": {
            "properties": {
              "python_version": {
                "not": {
                  "pattern": "[\\r\\n]"
                },
                "pattern": "^3[.]12[.](?:0|[1-9][0-9]{0,2})$"
              }
            }
          }
        }
      ],
      "properties": {
        "daemon_artifact_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Daemon Artifact Sha256",
          "type": "string"
        },
        "daemon_version": {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "[Xx][Nn]--"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]{0,63}$",
          "title": "Daemon Version",
          "type": "string"
        },
        "python_abi": {
          "enum": [
            "cp311",
            "cp312"
          ],
          "title": "Python Abi",
          "type": "string"
        },
        "python_executable": {
          "maxLength": 512,
          "minLength": 2,
          "not": {
            "anyOf": [
              {
                "pattern": "//"
              },
              {
                "pattern": "(?:^|/)[.]{1,2}(?:/|$)"
              },
              {
                "pattern": "/$"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^/(?:[A-Za-z0-9._+-]+/)*[A-Za-z0-9._+-]+$",
          "title": "Python Executable",
          "type": "string"
        },
        "python_version": {
          "maxLength": 11,
          "minLength": 5,
          "not": {
            "pattern": "[\\r\\n]"
          },
          "pattern": "^(?:0|[1-9][0-9]{0,2})[.](?:0|[1-9][0-9]{0,2})[.](?:0|[1-9][0-9]{0,2})$",
          "title": "Python Version",
          "type": "string"
        },
        "runtime_inventory_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Inventory Sha256",
          "type": "string"
        },
        "sdk_artifact_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sdk Artifact Sha256",
          "type": "string"
        },
        "sdk_version": {
          "maxLength": 64,
          "minLength": 1,
          "not": {
            "anyOf": [
              {
                "pattern": "[Xx][Nn]--"
              },
              {
                "pattern": "[\\r\\n]"
              }
            ]
          },
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+!-]{0,63}$",
          "title": "Sdk Version",
          "type": "string"
        },
        "selected_wheel_tag": {
          "const": "py3-none-any",
          "title": "Selected Wheel Tag",
          "type": "string"
        },
        "target_tag_set_sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Tag Set Sha256",
          "type": "string"
        }
      },
      "required": [
        "python_executable",
        "python_version",
        "python_abi",
        "selected_wheel_tag",
        "target_tag_set_sha256",
        "sdk_version",
        "sdk_artifact_sha256",
        "daemon_version",
        "daemon_artifact_sha256",
        "runtime_inventory_sha256"
      ],
      "title": "ReachyA05RuntimeBinding",
      "type": "object"
    }
  },
  "$id": "https://tuntun.local/schemas/evidence/reachy-a05-operator-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Structural private-state schema; runtime model parsing is required for freshness, fixed-path, distinctness, lifecycle, and repository semantics.",
  "discriminator": {
    "mapping": {
      "bound": "#/$defs/ReachyA05CommissioningStateV1",
      "revoked": "#/$defs/ReachyA05RevokedTombstoneV1"
    },
    "propertyName": "record_kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/ReachyA05CommissioningStateV1"
    },
    {
      "$ref": "#/$defs/ReachyA05RevokedTombstoneV1"
    }
  ],
  "x-tuntun-runtime-semantic-validation-required": true,
  "x-tuntun-validation-scope": "structural"
}
